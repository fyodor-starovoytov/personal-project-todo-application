<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<VBox alignment="CENTER" spacing="20.0" prefHeight="400.0"
      prefWidth="400.0" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.star.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <GridPane vgap="20.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="25.0"/>
            <ColumnConstraints percentWidth="50.0"/>
            <ColumnConstraints percentWidth="25.0"/>
        </columnConstraints>


        <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <TextField fx:id="taskAddField" text="Add task"/>
            <Button fx:id="addButton" text="Add"/>
        </HBox>

        <VBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Pending Tasks"/>
            <VBox fx:id="incompleteTasks" spacing="10" alignment="CENTER_LEFT"/>
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Complete Tasks"/>
            <VBox fx:id="completeTasks" spacing="10" alignment="CENTER_LEFT"/>
        </VBox>
    </GridPane>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

</VBox>
